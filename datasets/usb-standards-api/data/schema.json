{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chirag127.github.io/usb-standards/data/schema.json",
  "title": "USB Standards",
  "description": "USB 2.0/3.x/4 with speeds, connector types, and power delivery",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique identifier"
      },
      "name": {
        "type": "string",
        "description": "Display name"
      }
    }
  }
}
